// Noctalia Shell keybindings.
//
// Was generated by shell-switch, which has since been removed along with the
// DankMaterialShell alternative — so this is now hand-edited like any other
// config file. Included last by config.kdl, so it wins any shared chord.

binds {
    Mod+Space hotkey-overlay-title="Open Noctalia Shell Launcher" {
        spawn "qs" "-c" "noctalia-shell" "ipc" "call" "launcher" "toggle";
    }
    Mod+E hotkey-overlay-title="Open Noctalia Shell Emoji Launcher" { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "launcher" "emoji"; }
}
