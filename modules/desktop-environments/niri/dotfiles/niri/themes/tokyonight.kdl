// Tokyo Night Storm palette for niri layout primitives.
// Sourced via `include "./current-theme.kdl"` in config.kdl AFTER the shell
// theme (noctalia / dms), so these values win.

layout {
    focus-ring {
        active-color   "#7aa2f7"
        inactive-color "#292e42"
        urgent-color   "#f7768e"
    }

    border {
        active-color   "#7aa2f7"
        inactive-color "#292e42"
        urgent-color   "#f7768e"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#7aa2f7"
        inactive-color "#292e42"
        urgent-color   "#f7768e"
    }

    insert-hint {
        color "#7aa2f780"
    }
}
