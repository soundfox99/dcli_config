// Start up Commands

// noctalia itself is started from shell-switcher-startup.kdl.

// Polkit authentication agent. niri is the only DE on arch-desktop now, so
// nothing else brings one up — without this, any GUI action needing auth
// (mounting a disk, GParted, some updaters) silently gets no prompt.
spawn-at-startup "/usr/lib/polkit-kde-authentication-agent-1"

// sunshine is not installed and is not declared by any module, so this spawn
// failed silently at every login. Re-enable it together with a "sunshine"
// entry in the niri module's package list if you actually want game streaming.
// spawn-at-startup "sunshine"
spawn-at-startup "swayidle" "-w" "timeout" "1800" "qs -c noctalia-shell ipc call lockScreen lock"
spawn-at-startup "sway-audio-idle-inhibit"

// To run a shell command (with variables, pipes, etc.), use spawn-sh-at-startup:
// spawn-sh-at-startup "qs -c ~/source/qs/MyAwesomeShell"

hotkey-overlay {
    // Uncomment this line to disable the "Important Hotkeys" pop-up at startup.
skip-at-startup
}
