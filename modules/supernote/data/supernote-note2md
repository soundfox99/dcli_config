#!/usr/bin/env python3
"""Generate Obsidian-readable .md companions for Supernote .note files.

Reads .note files from Supernote/Backup/ and writes .md into Supernote/Markdown/,
mirroring the folder structure. The two trees are kept separate so no folder
holds Foo.note and Foo.md side by side — that makes Obsidian's shortest-path
link resolution ambiguous and clutters the file explorer.

Supernote/Backup/ is the untouched device clone. Supernote/Markdown/ is entirely
generated: it is rewritten on change and orphans are pruned, so do not hand-edit
files there.

Incremental: a .note whose .md is newer is skipped, so scheduled runs are close
to free. Pass --force to rebuild everything.
"""
import os, subprocess, sys, tempfile, datetime

VAULT = os.path.expanduser("~/Documents/ObsidianVaults")
SRC = os.path.join(VAULT, "Supernote", "Backup")
DST = os.path.join(VAULT, "Supernote", "Markdown")
TOOL = os.path.expanduser("~/.local/bin/supernote-tool")
FORCE = "--force" in sys.argv

def extract_text(note_path):
    tmp = tempfile.mktemp(suffix=".txt")
    try:
        subprocess.run([TOOL, "convert", "-t", "txt", "-a", note_path, tmp],
                       capture_output=True, timeout=300)
        if os.path.exists(tmp):
            with open(tmp, encoding="utf-8", errors="replace") as fh:
                return fh.read().strip()
    except Exception as e:
        print(f"  ! extract failed for {os.path.basename(note_path)}: {e}", flush=True)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)
    return ""

def yaml_escape(s):
    return '"' + s.replace('\\', '\\\\').replace('"', '\\"') + '"'

if not os.path.isdir(SRC):
    print(f"[skip] {SRC} does not exist"); sys.exit(0)
if not os.path.exists(TOOL):
    print(f"[error] supernote-tool not found at {TOOL}"); sys.exit(1)

notes = sorted(os.path.join(dp, fn)
               for dp, _, fns in os.walk(SRC)
               for fn in fns if fn.endswith(".note"))

expected = set()
built = skipped = with_text = 0

for note in notes:
    rel = os.path.relpath(note, SRC)
    md_path = os.path.join(DST, os.path.splitext(rel)[0] + ".md")
    expected.add(os.path.realpath(md_path))

    if not FORCE and os.path.exists(md_path) \
       and os.path.getmtime(md_path) >= os.path.getmtime(note):
        skipped += 1
        continue

    text = extract_text(note)
    has = bool(text)
    with_text += has
    built += 1
    stem = os.path.splitext(os.path.basename(rel))[0]

    body = [
        "---", "source: supernote",
        f"note_file: {yaml_escape(os.path.join('Supernote/Backup', rel))}",
        f"recognized: {'true' if has else 'false'}",
        f"converted: {datetime.date.today().isoformat()}",
        "---", "", f"# {stem}", "",
        "> [!info] Handwritten source",
        f"> Original: `Supernote/Backup/{rel}` — open the `.note` in Obsidian to "
        "view it rendered by the Supernote plugin.", "",
        "## Recognized text", "",
        text if has else
        "*No handwriting-recognition text is stored in this file.* The pages "
        "exist only as strokes, so there is nothing to extract. Enable "
        "real-time recognition on the device and re-open the note there.",
        "",
    ]
    os.makedirs(os.path.dirname(md_path), exist_ok=True)
    with open(md_path, "w", encoding="utf-8") as fh:
        fh.write("\n".join(body))
    print(f"  built {rel} ({'text' if has else 'no text'})", flush=True)

# prune .md whose .note is gone. Guarded on the frontmatter marker so nothing
# that did not come from this script is ever removed.
pruned = 0
for dp, _, fns in os.walk(DST):
    for fn in fns:
        if not fn.endswith(".md"):
            continue
        p = os.path.join(dp, fn)
        if os.path.realpath(p) in expected:
            continue
        try:
            with open(p, encoding="utf-8", errors="replace") as fh:
                if "source: supernote" not in fh.read(200):
                    continue
        except OSError:
            continue
        os.unlink(p); pruned += 1
        print(f"  pruned {os.path.relpath(p, DST)} (source .note gone)", flush=True)

for dp, dns, fns in os.walk(DST, topdown=False):
    if dp != DST and not dns and not fns:
        os.rmdir(dp)

print(f"[done] {built} rebuilt ({with_text} with text), {skipped} unchanged, "
      f"{pruned} pruned, {len(notes)} total", flush=True)
